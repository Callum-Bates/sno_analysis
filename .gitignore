# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Jupyter ---
.ipynb_checkpoints/

# --- Data ---
# Raw/processed data can be large and shouldn't live in git history.
# Comment these out if you specifically want small files tracked.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# --- Figures (optional - uncomment if outputs shouldn't be tracked) ---
# figures/*
# !figures/.gitkeep

# --- R ---
.Rhistory
.RData
.Rproj.user/

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- Environment / secrets ---
.env
